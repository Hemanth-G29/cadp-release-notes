# --- OpenProject ---
# API key (Basic auth as "apikey:<token>"). In production this comes from Secret Manager.
OPENPROJECT_TOKEN=
OPENPROJECT_HOST=pmt.cavininfotech.com
OPENPROJECT_PROJECT_ID=3

# --- Release / cutoff ---
# ISO-8601 UTC instant. Bugs whose status moved to Developed after this go into the live doc.
# Left blank => the live doc = ALL bugs currently in Developed (correct right after a rollover).
RELEASE_CUTOFF_ISO=
# The build number of the current LIVE (in-progress) doc.
LIVE_VERSION=19

# --- Storage ---
# pages | local | gcs
#   pages : GitHub Pages model — writes a static site tree under SITE_DIR (default ./site)
#   local : dev — writes under ./out
#   gcs   : Cloud Run model — GCS bucket
STORE_BACKEND=local
SITE_DIR=site
GCS_BUCKET=

# --- Microsoft Graph (mail-driven rollover; Phase 2) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=hemanth.a@hepl.com
RELEASE_MAIL_SUBJECT=CADP - QA Release

# --- Narrative sources ---
# CHANGELOG_ROOT: a checkout root that contains the platform repos' docs/changes/*.md
# (Services/<svc>/docs/changes, cadp_frontend_reactjs/docs/changes). Blank => skip tag aggregation.
CHANGELOG_ROOT=
# CONTENT_DIR: optional human-edited manifests (known-issues/api-changes/config-changes .md).
CONTENT_DIR=content

# --- Git host (reserved; API-based docs/changes fetch) ---
GIT_API_BASE=
GIT_READ_TOKEN=

# --- Server ---
PORT=8080
# Shared token required on POST /tick, /rollover, /approve (Cloud Scheduler sends it / OIDC).
CONTROL_TOKEN=
